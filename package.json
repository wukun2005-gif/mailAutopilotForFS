{
  "name": "email-autopilot-fs-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Email Autopilot for Financial Services — usability prototype (Larkspur Bank, fictional data). PRD v0.3 Appendix A (incl. Act 4 design-time intelligence) / Dev Plan v0.4.1.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:demo": "playwright test tests/e2e/m7-demo-smoke.spec.ts",
    "e2e:shots": "playwright test tests/e2e/shots.spec.ts",
    "eval": "promptfoo eval -c promptfoo.config.ts",
    "tts": "bash tts/generate.sh",
    "i18n:audit": "i18next-parser --config i18next-parser.config.ts",
    "audit:prd": "tsx scripts/audit-prd.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.13",
    "@langchain/langgraph": "1.4.18",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dompurify": "3.4.16",
    "framer-motion": "13.4.4",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "idb": "8.0.3",
    "lucide-react": "1.48.0",
    "marked": "18.0.14",
    "msw": "2.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/dompurify": "3.0.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "^6.2.4",
    "i18next-parser": "9.4.0",
    "jsdom": "30.1.1",
    "promptfoo": "0.123.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "tsx": "^4.23.15"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
