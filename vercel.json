{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_doc": "Vercel config for the Email Autopilot prototype. The app is a pure static SPA — MSW runs the entire mock backend in the browser, so no server / API is deployed here. `npm run dev` for the Dev BFF stays a local-only feature.",

  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install",

  "cleanUrls": true,
  "trailingSlash": false,

  "headers": [
    {
      "source": "/mockServiceWorker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(assets|tts)/(.+)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(bgm-trailer.mp3|demo-intro.gif|email-flow-before-after.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
